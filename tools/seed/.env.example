# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).
QF_CLIENT_ID=your-client-id
QF_CLIENT_SECRET=your-client-secret

# Optional overrides (defaults shown):
# QF_OAUTH_URL=https://oauth2.quran.foundation/oauth2/token
# QF_API_BASE=https://apis.quran.foundation/content/api/v4
# MUSHAF=1
# OUT_DIR=../../assets/quran

# Fonts are skipped unless you set a URL template with a {page} placeholder, e.g.
# FONT_URL_TEMPLATE=https://<qcf-v2-font-host>/p{page}.woff2
